    <script>
      var tnfdSkipUnsubscribeFormIds = [61,109];
      (function() {

        function initField(field) {
          if (field.dataset.commInit) return;
          field.dataset.commInit = '1';

          var list = field.querySelector('.gfield_checkbox');
          if (!list) return;

          // Derive form ID from the closest GF <form> element
          var formEl = field.closest('form[id^="gform_"]');
          var formId = formEl ? parseInt(formEl.id.replace('gform_', ''), 10) : 0;

          function getRealCheckboxes() {
            return Array.prototype.slice.call(
              list.querySelectorAll('input[type="checkbox"][name]')
            );
          }

          function getVisibleCheckboxes() {
            return getRealCheckboxes().filter(function(cb) {
              return cb.offsetParent !== null && cb.value !== 'general_communications';
            });
          }

          // ── Find the general_communications checkbox ──────────────────────
          var generalCb = list.querySelector('input[value="general_communications"]');
          if (!generalCb) return;

          // ── Build "Unsubscribe from all" and append at the bottom ─────────
          // check if the form is gravity form 61 if so don't add in unsubscribe all as it is already added in the form editor

          if (tnfdSkipUnsubscribeFormIds.includes(formId)) {
            console.log('Skipping unsubscribe from all for form ID ' + formId);
            return;
          }

          var unsubItem = document.createElement('div');
          unsubItem.className = 'gchoice gchoice--unsubscribe-all';
          unsubItem.innerHTML =
            '<div class="gchoice__divider"></div>' +
            '<input class="gfield-choice-input" type="checkbox" id="choice--unsubscribe-all">' +
            '<label for="choice--unsubscribe-all" class="gform-field-label gform-field-label--type-inline">Unsubscribe from all <br><span>Stop receiving all emails from the TNFD, including newsletters, event invitations, webinars, guidance updates and capacity building communications.</span></label>';

          list.appendChild(unsubItem);

          var unsubCb = unsubItem.querySelector('input');

          // ── Ticking general_communications cascades to all others ─────────
          generalCb.addEventListener('change', function() {
            if (this.checked) {
              unsubCb.checked = false;
              getVisibleCheckboxes().forEach(function(cb) {
                cb.checked = true;
              });
            } else {
              getVisibleCheckboxes().forEach(function(cb) {
                cb.checked = false;
              });
            }
          });

          // ── Unsubscribe: unchecks everything including general ────────────
          unsubCb.addEventListener('change', function() {
            if (this.checked) {
              getRealCheckboxes().forEach(function(cb) {
                cb.checked = false;
              });
            }
          });

          // ── Individual checkboxes only clear the unsubscribe option ───────
          // general_communications is never touched by individual changes
          getVisibleCheckboxes().forEach(function(cb) {
            cb.addEventListener('change', function() {
              unsubCb.checked = false;
            });
          });
        }

        function initAll() {
          document.querySelectorAll('.communication-form-field').forEach(initField);
        }

        document.addEventListener('DOMContentLoaded', initAll);
        jQuery(document).on('gform_post_render', initAll);

      })();
    </script>
    <style>
      .gchoice--unsubscribe-all .gchoice__divider {
        border-top: 1px solid #e0e0e0;
        margin: 12px 0 10px;
      }
    </style>
